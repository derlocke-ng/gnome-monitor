#!/usr/bin/env python3
"""gnome-monitor-panel — Gnome Monitor, the GTK4/libadwaita panel (GNOME 40+).

A picture of the layout (drag screens around behind Edit), the profiles —
click one to apply it — and one row per connected screen: on/off, main, and a
gear for resolution, refresh rate and scale. Every change goes straight to
Mutter, the same way GNOME Settings does it.
"""
import os
import signal
import sys
import threading

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("PangoCairo", "1.0")
from gi.repository import Gtk, Adw, GLib, Gio, Gdk, Pango, PangoCairo  # noqa: E402

_here = os.path.dirname(os.path.realpath(__file__))
for _d in (os.path.join(_here, "..", "share", "gnome-monitor"), os.path.join(_here, "..", "lib")):
    if os.path.exists(os.path.join(_d, "gnomemonitor.py")):
        sys.path.insert(0, os.path.normpath(_d))
        break
import gnomemonitor as gm  # noqa: E402

APP_ID = "eu.kiwinetwork.GnomeMonitor"
MAP_HEIGHT = 170


# ── main window ──────────────────────────────────────────────────────────────

class MonitorWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Gnome Monitor")
        self.set_default_size(600, -1)      # as tall as the content
        self._busy = False
        self._updating = False      # filling widgets, not the user
        self._lay = None
        self._rows: dict = {}       # monitor.key -> widgets
        self._refresh_pending = None
        self._dialog = None         # the open screen dialog's widgets
        # arranging
        self._editing = False
        self._edit_lay = None
        self._world = None          # fixed picture frame while arranging
        self._drag = None
        self._xform = None          # (scale, ox, oy) of the last drawn map
        self._actions()
        self._build()
        self._refresh()
        # Mutter says when the layout changes — GNOME Settings, a cable, or us
        try:
            self._proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SESSION, Gio.DBusProxyFlags.DO_NOT_LOAD_PROPERTIES, None,
                gm.BUS_NAME, gm.OBJECT_PATH, gm.INTERFACE, None)
            self._proxy.connect("g-signal", self._on_dbus_signal)
        except GLib.Error:
            self._proxy = None

    # ── actions / menu ─────────────────────────────────────────────────────
    def _actions(self):
        a = Gio.SimpleAction.new_stateful("ask-to-keep", None,
                                          GLib.Variant.new_boolean(gm.ask_to_keep()))
        a.connect("change-state", self._on_ask_to_keep)
        self.add_action(a)
        a = Gio.SimpleAction.new_stateful("restore-at-login", None,
                                          GLib.Variant.new_boolean(gm.restore_at_login()))
        a.connect("change-state", self._on_restore_at_login)
        self.add_action(a)
        a = Gio.SimpleAction.new("open-folder", None)
        a.connect("activate", self._open_folder)
        self.add_action(a)

    def _on_ask_to_keep(self, action, value):
        action.set_state(value)
        gm.set_ask_to_keep(value.get_boolean())
        self._set_status("GNOME asks to keep each change and remembers it itself."
                         if value.get_boolean() else
                         "Changes apply quietly; the last one is put back at login.")

    def _on_restore_at_login(self, action, value):
        action.set_state(value)
        try:
            gm.set_restore_at_login(value.get_boolean())
        except OSError as e:
            self._toast(f"Could not change the autostart entry: {e}")
            return
        self._set_status("The last layout is put back when you log in."
                         if value.get_boolean() else
                         "Nothing is put back at login — GNOME uses what it remembers.")

    def _open_folder(self, *_):
        os.makedirs(gm.PROFILES_DIR, exist_ok=True)
        Gio.AppInfo.launch_default_for_uri(f"file://{gm.PROFILES_DIR}", None)

    # ── layout ─────────────────────────────────────────────────────────────
    def _build(self):
        root = Adw.ToolbarView()
        self.set_content(root)

        hdr = Adw.HeaderBar()
        hdr.set_title_widget(Adw.WindowTitle(title="Gnome Monitor"))
        btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic", tooltip_text="Refresh")
        btn_refresh.connect("clicked", lambda *_: self._refresh())
        hdr.pack_start(btn_refresh)
        menu = Gio.Menu()
        menu.append("Ask to Keep Changes (GNOME dialog)", "win.ask-to-keep")
        menu.append("Restore Layout at Login", "win.restore-at-login")
        menu.append("Open Profiles Folder", "win.open-folder")
        hdr.pack_end(Gtk.MenuButton(icon_name="open-menu-symbolic", menu_model=menu,
                                    tooltip_text="Menu"))
        root.add_top_bar(hdr)

        self._toasts = Adw.ToastOverlay()
        root.set_content(self._toasts)
        scroll = Gtk.ScrolledWindow(vexpand=True, propagate_natural_height=True)
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self._toasts.set_child(scroll)
        page = Adw.PreferencesPage()
        scroll.set_child(page)

        # ── the picture ──────────────────────────────────────────────────
        map_grp = Adw.PreferencesGroup(title="Layout")
        btns = Gtk.Box(spacing=6)
        self._edit_btn = Gtk.Button(label="Edit", tooltip_text="Arrange the screens by dragging")
        self._edit_btn.connect("clicked", lambda *_: self._start_edit())
        self._cancel_btn = Gtk.Button(label="Cancel", visible=False)
        self._cancel_btn.connect("clicked", lambda *_: self._stop_edit())
        self._apply_btn = Gtk.Button(label="Apply", visible=False)
        self._apply_btn.add_css_class("suggested-action")
        self._apply_btn.connect("clicked", lambda *_: self._apply_edit())
        for b in (self._edit_btn, self._cancel_btn, self._apply_btn):
            btns.append(b)
        map_grp.set_header_suffix(btns)
        page.add(map_grp)
        self._map = Gtk.DrawingArea(content_height=MAP_HEIGHT, hexpand=True)
        self._map.set_draw_func(self._draw_map)
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self._drag_begin)
        drag.connect("drag-update", self._drag_update)
        drag.connect("drag-end", self._drag_end)
        self._map.add_controller(drag)
        card = Adw.Bin(child=self._map)
        card.add_css_class("card")
        map_grp.add(card)

        # ── monitors ─────────────────────────────────────────────────────
        self._mon_grp = Adw.PreferencesGroup(title="Monitors")
        page.add(self._mon_grp)

        # ── profiles: one row each, a click applies; the last row saves ──
        self._prof_grp = Adw.PreferencesGroup(title="Profiles")
        page.add(self._prof_grp)
        self._profile_rows = []
        self._save_row = Adw.ActionRow(title="Save the current layout as")
        self._name_entry = Gtk.Entry(placeholder_text="name", width_chars=14,
                                     valign=Gtk.Align.CENTER)
        self._name_entry.connect("activate", lambda *_: self._save_profile())
        save_btn = Gtk.Button(label="Save", valign=Gtk.Align.CENTER)
        save_btn.add_css_class("suggested-action")
        save_btn.connect("clicked", lambda *_: self._save_profile())
        self._save_row.add_suffix(self._name_entry)
        self._save_row.add_suffix(save_btn)
        self._prof_grp.add(self._save_row)

        # ── status bar ───────────────────────────────────────────────────
        self._status_lbl = Gtk.Label(label="", xalign=0, margin_start=16, margin_end=16,
                                     margin_top=4, margin_bottom=4, ellipsize=Pango.EllipsizeMode.END)
        self._status_lbl.add_css_class("caption")
        self._status_lbl.add_css_class("dim-label")
        root.add_bottom_bar(self._status_lbl)

    # ── helpers ────────────────────────────────────────────────────────────
    def _set_status(self, text):
        self._status_lbl.set_label(text)
        self._status_lbl.set_tooltip_text(text)

    def _toast(self, text, timeout=4):
        self._toasts.add_toast(Adw.Toast(title=text, timeout=timeout))
        self._set_status(text)

    def _on_dbus_signal(self, _proxy, _sender, signal, _params):
        if signal == "MonitorsChanged":
            if self._refresh_pending:
                GLib.source_remove(self._refresh_pending)
            self._refresh_pending = GLib.timeout_add(400, self._refresh_later)

    def _refresh_later(self):
        self._refresh_pending = None
        self._refresh()
        return GLib.SOURCE_REMOVE

    def _monitor(self, key):
        return next((m for m in self._lay.state.monitors if m.key == key), None)

    # ── refresh ────────────────────────────────────────────────────────────
    def _refresh(self):
        try:
            self._lay = gm.Layout(gm.get_state())
            gm.remember(self._lay)
        except gm.MonitorError as e:
            self._set_status(str(e))
            return
        if self._editing:
            # the screens changed under us — start over from what is there now
            self._stop_edit()
        self._updating = True
        try:
            self._populate_monitors()
            self._populate_profiles()
            if self._dialog:
                m = self._monitor(self._dialog["key"])
                if m:
                    self._fill_dialog(m)
        finally:
            self._updating = False
        self._map.queue_draw()
        lay = self._lay
        n_on = sum(len(l.monitors) for l in lay.logicals)
        active = gm.active_profiles(lay)
        self._set_status(f"{len(lay.state.monitors)} connected · {n_on} on"
                         + (f" · profile: {', '.join(active)}" if active else ""))

    def _populate_monitors(self):
        lay = self._lay
        mons = lay.monitors()
        keys = [m.key for m in mons]
        if keys != list(self._rows):
            for rd in self._rows.values():
                self._mon_grp.remove(rd["row"])
            self._rows = {}
            first_check = None
            for m in mons:
                rd = self._make_monitor_row(m, first_check)
                first_check = first_check or rd["main"]
                self._mon_grp.add(rd["row"])
                self._rows[m.key] = rd
        for m in mons:
            self._update_monitor_row(m)

    def _make_monitor_row(self, m, group_check):
        row = Adw.ActionRow(title=m.name, icon_name="video-display-symbolic", subtitle_lines=1)
        main = Gtk.CheckButton(label="Main", valign=Gtk.Align.CENTER, tooltip_text="Main screen")
        if group_check:
            main.set_group(group_check)
        main.connect("toggled", self._on_main, m.key)
        row.add_suffix(main)
        switch = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text="On / off")
        switch.connect("notify::active", self._on_switch, m.key)
        row.add_suffix(switch)
        gear = Gtk.Button(icon_name="emblem-system-symbolic", valign=Gtk.Align.CENTER,
                          tooltip_text="Resolution, refresh rate, scale")
        gear.add_css_class("flat")
        gear.connect("clicked", lambda _b, k=m.key: self._open_dialog(k))
        row.add_suffix(gear)
        return {"row": row, "main": main, "switch": switch}

    def _update_monitor_row(self, m):
        rd = self._rows[m.key]
        lay = self._lay
        l = lay.logical_of(m)
        rd["switch"].set_active(l is not None)
        rd["main"].set_sensitive(l is not None)
        rd["main"].set_active(bool(l and l.primary))
        if l:
            r = l.rect(lay.layout_mode)
            extra = ""
            if abs(l.scale - 1) > 1e-3:
                extra += f" · {l.scale * 100:.0f} %"
            if l.transform:
                extra += f" · {gm.TRANSFORMS[l.transform]}"
            rd["row"].set_subtitle(f"{m.connector} · {m.mode} · at {r.x},{r.y}{extra}")
        else:
            rd["row"].set_subtitle(f"{m.connector} · off")

    def _populate_profiles(self):
        for r in self._profile_rows:
            self._prof_grp.remove(r)
        self._profile_rows = []
        self._prof_grp.remove(self._save_row)     # it goes back in last
        names = gm.list_profiles()
        active = set(gm.active_profiles(self._lay))
        for name in names:
            try:
                other, _ = gm.layout_from_profile(gm.load_profile(name), self._lay.state)
                text = other.compact() or "none of its screens is connected"
                tip = other.summary() + "\n(click to apply)"
            except gm.MonitorError as e:
                text, tip = f"broken: {e}", None
            row = Adw.ActionRow(title=name, subtitle=text, subtitle_lines=1, activatable=True,
                                tooltip_text=tip)
            row.connect("activated", lambda _r, n=name: self._apply_profile(n))
            mark = Gtk.Image(icon_name="object-select-symbolic")
            mark.add_css_class("accent")
            if name not in active:
                mark.set_opacity(0)
            row.add_prefix(mark)
            if gm.shortcuts_available():
                key = gm.shortcut_get(name)
                if key:
                    ok, kv, mods = Gtk.accelerator_parse(key)
                    key_btn = Gtk.Button(label=Gtk.accelerator_get_label(kv, mods) if ok else key,
                                         valign=Gtk.Align.CENTER, tooltip_text="Change the shortcut")
                else:
                    key_btn = Gtk.Button(icon_name="input-keyboard-symbolic", valign=Gtk.Align.CENTER,
                                         tooltip_text="Set a keyboard shortcut")
                key_btn.add_css_class("flat")
                key_btn.connect("clicked", lambda _b, n=name: self._edit_shortcut(n))
                row.add_suffix(key_btn)
            del_btn = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                                 tooltip_text="Delete profile")
            del_btn.add_css_class("flat")
            del_btn.connect("clicked", lambda _b, n=name: self._delete_profile(n))
            row.add_suffix(del_btn)
            self._prof_grp.add(row)
            self._profile_rows.append(row)
        self._prof_grp.add(self._save_row)
        self._save_row.set_subtitle("Click a profile to apply it" if names
                                    else "No profiles yet — the first one is one click away")

    # ── the picture ────────────────────────────────────────────────────────
    def _draw_map(self, area, cr, width, height):
        fg = area.get_color()
        lay = self._edit_lay if self._editing else self._lay
        if not lay or not lay.logicals:
            self._text(cr, "every screen is off", width / 2, height / 2, fg, "Cantarell 11", width)
            self._xform = None
            return
        lm = lay.layout_mode
        items = [(l, l.rect(lm)) for l in lay.ordered_logicals()]
        pad = 14
        if self._editing and self._world:
            wx0, wy0, wx1, wy1 = self._world
        else:
            wx0, wy0 = 0, 0
            wx1 = max(r.right for _, r in items)
            wy1 = max(r.bottom for _, r in items)
        s = min((width - 2 * pad) / (wx1 - wx0), (height - 2 * pad) / (wy1 - wy0))
        ox = (width - (wx1 - wx0) * s) / 2 - wx0 * s
        oy = (height - (wy1 - wy0) * s) / 2 - wy0 * s
        self._xform = (s, ox, oy)
        sm = Adw.StyleManager.get_default()
        accent = (sm.get_accent_color_rgba() if hasattr(sm, "get_accent_color_rgba")
                  else Gdk.RGBA(red=0.21, green=0.52, blue=0.89, alpha=1))
        dragging = self._drag[0] if self._drag else None
        for l, r in items:
            x, y, w, h = ox + r.x * s + 2, oy + r.y * s + 2, r.w * s - 4, r.h * s - 4
            self._rounded(cr, x, y, w, h, 8)
            col = accent if l.primary else fg
            fill = 0.22 if l.primary else 0.08
            if l is dragging:
                fill += 0.12
            cr.set_source_rgba(col.red, col.green, col.blue, fill)
            cr.fill_preserve()
            cr.set_source_rgba(col.red, col.green, col.blue, 1 if l.primary else 0.45)
            cr.set_line_width(2 if (l.primary or l is dragging) else 1)
            cr.stroke()
            cx, cy = x + w / 2, y + h / 2
            name = l.label + ("  ★" if l.primary else "")
            self._text(cr, name, cx, cy - 16, fg, "Cantarell Bold 11", w - 12)
            self._text(cr, str(l.monitors[0].mode), cx, cy + 2, fg, "Cantarell 9", w - 12)
            self._text(cr, ", ".join(m.connector for m in l.monitors), cx, cy + 18, fg,
                       "Cantarell 9", w - 12, alpha=0.6)
        if self._editing:
            self._text(cr, "drag a screen to where it should be", width / 2, height - 10, fg,
                       "Cantarell Italic 9", width, alpha=0.6)

    @staticmethod
    def _rounded(cr, x, y, w, h, r):
        r = min(r, w / 2, h / 2)
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -1.5708, 0)
        cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
        cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
        cr.arc(x + r, y + r, r, 3.1416, 4.7124)
        cr.close_path()

    @staticmethod
    def _text(cr, text, cx, cy, col, font, max_w, alpha=1.0):
        layout = PangoCairo.create_layout(cr)
        layout.set_text(text, -1)
        layout.set_font_description(Pango.FontDescription(font))
        layout.set_width(int(max(max_w, 10) * Pango.SCALE))
        layout.set_ellipsize(Pango.EllipsizeMode.END)
        layout.set_alignment(Pango.Alignment.CENTER)
        _ink, log = layout.get_pixel_extents()
        cr.set_source_rgba(col.red, col.green, col.blue, alpha)
        cr.move_to(cx - max(max_w, 10) / 2, cy - log.height / 2)
        PangoCairo.show_layout(cr, layout)

    # ── arranging ──────────────────────────────────────────────────────────
    def _start_edit(self):
        if self._busy or not self._lay or not self._lay.logicals:
            return
        self._editing = True
        self._edit_lay = gm.Layout(self._lay.state)
        lm = self._edit_lay.layout_mode
        rects = [l.rect(lm) for l in self._edit_lay.logicals]
        max_x = max(r.right for r in rects)
        max_y = max(r.bottom for r in rects)
        # room around the layout, so a screen can be dragged to any side
        mx, my = max_x * 0.15, max_y * 0.6
        self._world = (-mx, -my, max_x + mx, max_y + my)
        self._edit_btn.set_visible(False)
        self._cancel_btn.set_visible(True)
        self._apply_btn.set_visible(True)
        self._map.set_content_height(MAP_HEIGHT + 90)
        self._map.set_cursor_from_name("grab")
        self._prof_grp.set_sensitive(False)
        self._mon_grp.set_sensitive(False)
        self._set_status("Drag a screen to where it should be, then Apply.")
        self._map.queue_draw()

    def _stop_edit(self):
        self._editing = False
        self._edit_lay = None
        self._world = None
        self._drag = None
        self._edit_btn.set_visible(True)
        self._cancel_btn.set_visible(False)
        self._apply_btn.set_visible(False)
        self._map.set_content_height(MAP_HEIGHT)
        self._map.set_cursor(None)
        self._prof_grp.set_sensitive(True)
        self._mon_grp.set_sensitive(True)
        self._map.queue_draw()

    def _apply_edit(self):
        lay = self._edit_lay
        if not lay:
            return
        notes = lay.normalize()
        self._stop_edit()
        if lay.same_as(self._lay):
            self._set_status("Nothing moved.")
            return
        self._commit(lay, notes, already_normalized=True)

    def _drag_begin(self, _g, x, y):
        self._drag = None
        if not self._editing or not self._xform or not self._edit_lay:
            return
        s, ox, oy = self._xform
        lx, ly = (x - ox) / s, (y - oy) / s
        lm = self._edit_lay.layout_mode
        for l in reversed(self._edit_lay.ordered_logicals()):
            r = l.rect(lm)
            if r.x <= lx < r.right and r.y <= ly < r.bottom:
                # the picture's scale is frozen for the whole drag
                self._drag = (l, l.x, l.y, s)
                break
        self._map.queue_draw()

    def _drag_update(self, _g, dx, dy):
        if not self._drag:
            return
        l, x0, y0, s = self._drag
        x, y = gm.snap(self._edit_lay, l, round(x0 + dx / s), round(y0 + dy / s), s)
        if not gm.overlaps_any(self._edit_lay, l, x, y):   # a screen is solid
            l.x, l.y = x, y
        self._map.queue_draw()

    def _drag_end(self, g, dx, dy):
        self._drag_update(g, dx, dy)
        self._drag = None
        self._map.queue_draw()

    # ── the screen dialog: resolution, refresh rate, scale ─────────────────
    def _open_dialog(self, key):
        m = self._monitor(key)
        if not m:
            return
        dlg = Adw.Dialog(title=m.name, content_width=440)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup()
        page.add(grp)
        tv.set_content(page)
        dlg.set_child(tv)

        res = Adw.ComboRow(title="Resolution")
        rate = Adw.ComboRow(title="Refresh rate")
        scale = Adw.ComboRow(title="Scale")
        for row in (res, rate, scale):
            grp.add(row)
        info = Adw.ActionRow(title=m.display_name or m.connector,
                             subtitle=f"{m.connector} · {m.vendor} {m.product} · {m.serial}",
                             selectable=False)
        info.add_css_class("property")
        grp.add(info)
        self._dialog = {"key": key, "res": res, "rate": rate, "scale": scale, "mode": None}
        self._updating = True
        try:
            self._fill_dialog(m)
        finally:
            self._updating = False
        res.connect("notify::selected", self._on_resolution, key)
        rate.connect("notify::selected", self._on_rate, key)
        scale.connect("notify::selected", self._on_scale, key)
        dlg.connect("closed", lambda *_: setattr(self, "_dialog", None))
        dlg.present(self)

    def _shown_mode(self, m):
        """What the combos show: the live mode, else what it last ran at."""
        if m.mode:
            return m.mode
        seen = gm.load_last_seen().get(m.key, {})
        return m.find_mode_id(seen.get("mode")) or m.preferred_mode or (m.modes[0] if m.modes else None)

    def _fill_dialog(self, m):
        d = self._dialog
        mode = self._shown_mode(m)
        d["mode"] = mode
        if not mode:
            return
        l = self._lay.logical_of(m)
        rlist = m.resolutions()
        d["res"].set_model(Gtk.StringList.new([f"{w}×{h}" for w, h in rlist]))
        d["res"].set_selected(rlist.index((mode.width, mode.height)))
        modes = m.modes_for(mode.width, mode.height)
        d["rate"].set_model(Gtk.StringList.new([mo.hz for mo in modes]))
        d["rate"].set_selected(modes.index(mode))
        scales = list(mode.scales)
        d["scale"].set_model(Gtk.StringList.new([f"{s * 100:.0f} %" for s in scales]))
        cur = l.scale if l else mode.preferred_scale
        idx = min(range(len(scales)), key=lambda i: abs(scales[i] - cur)) if scales else 0
        d["scale"].set_selected(idx)
        d["scale"].set_sensitive(l is not None)

    # ── changes ────────────────────────────────────────────────────────────
    def _on_switch(self, switch, _pspec, key):
        if self._updating or self._busy:
            return
        m = self._monitor(key)
        lay = self._lay
        try:
            notes = lay.on(m) if switch.get_active() else lay.off(m)
        except gm.MonitorError as e:
            self._toast(str(e))
            self._refresh()
            return
        self._commit(lay, notes)

    def _on_main(self, check, key):
        if self._updating or self._busy or not check.get_active():
            return
        m = self._monitor(key)
        lay = self._lay
        l = lay.logical_of(m)
        if l and l.primary:
            return
        try:
            notes = lay.set_main(m)
        except gm.MonitorError as e:
            self._toast(str(e))
            return
        self._commit(lay, notes)

    def _on_resolution(self, combo, _pspec, key):
        if self._updating or self._busy or not self._dialog:
            return
        m = self._monitor(key)
        w, h = m.resolutions()[combo.get_selected()]
        old = self._dialog["mode"]
        mode = m.find_mode(w, h, old.rate if old else None, old.vrr if old else None)
        if not mode or mode is old:
            return
        self._commit(self._lay, self._lay.set_mode(m, mode))

    def _on_rate(self, combo, _pspec, key):
        if self._updating or self._busy or not self._dialog:
            return
        m = self._monitor(key)
        old = self._dialog["mode"]
        modes = m.modes_for(old.width, old.height)
        idx = combo.get_selected()
        if idx >= len(modes) or modes[idx] is old:
            return
        self._commit(self._lay, self._lay.set_mode(m, modes[idx]))

    def _on_scale(self, combo, _pspec, key):
        if self._updating or self._busy or not self._dialog:
            return
        m = self._monitor(key)
        mode = self._dialog["mode"]
        scales = mode.scales if mode else []
        idx = combo.get_selected()
        l = self._lay.logical_of(m)
        if idx >= len(scales) or not l or abs(l.scale - scales[idx]) < 1e-3:
            return
        self._commit(self._lay, self._lay.set_scale(m, scales[idx]))

    def _apply_profile(self, name):
        if self._busy:
            return
        try:
            lay, notes = gm.layout_from_profile(gm.load_profile(name), self._lay.state)
        except gm.MonitorError as e:
            self._toast(str(e))
            return
        if not lay.logicals:
            self._toast(f"None of the screens in '{name}' is connected.")
            return
        if lay.same_as(self._lay):
            self._set_status(f"'{name}' is already in place.")
            return
        self._commit(lay, notes, already_normalized=True)

    def _commit(self, lay, notes, already_normalized=False):
        """normalize + apply off the main loop; the result lands in a toast."""
        if not already_normalized:
            notes = list(notes) + lay.normalize()
        self._busy = True
        method = gm.default_method()
        self._set_status("Applying…")

        def worker():
            try:
                lay.apply(method)
                msg = "; ".join(notes) if notes else "Applied."
                if method == gm.PERSISTENT:
                    msg += " — GNOME asks you to keep the changes."
                GLib.idle_add(self._commit_done, msg, True)
            except gm.MonitorError as e:
                GLib.idle_add(self._commit_done, f"Mutter refused: {e}", False)
        threading.Thread(target=worker, daemon=True).start()

    def _commit_done(self, msg, ok):
        self._busy = False
        self._toast(msg, timeout=5 if ok else 8)
        self._refresh()
        return False

    # ── profiles ───────────────────────────────────────────────────────────
    def _save_profile(self):
        name = self._name_entry.get_text().strip()
        if not name:
            self._toast("Enter a profile name first.")
            self._name_entry.grab_focus()
            return
        try:
            gm.check_name(name)
        except gm.MonitorError as e:
            self._toast(str(e))
            return
        if name in gm.list_profiles():
            dlg = Adw.AlertDialog(heading=f"Replace '{name}'?",
                                  body="The profile is overwritten with the current layout.")
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("replace", "Replace")
            dlg.set_response_appearance("replace", Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_default_response("cancel")
            dlg.set_close_response("cancel")
            dlg.connect("response", lambda _d, r: r == "replace" and self._do_save(name))
            dlg.present(self)
            return
        self._do_save(name)

    def _do_save(self, name):
        try:
            gm.save_profile(name, self._lay)
        except (gm.MonitorError, OSError) as e:
            self._toast(f"Could not save: {e}")
            return
        self._name_entry.set_text("")
        self._toast(f"Saved '{name}'.")
        self._refresh()

    # ── shortcuts: GNOME custom keybindings, captured like Settings does ───
    MODIFIER_KEYS = {Gdk.KEY_Shift_L, Gdk.KEY_Shift_R, Gdk.KEY_Control_L, Gdk.KEY_Control_R,
                     Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Super_L, Gdk.KEY_Super_R,
                     Gdk.KEY_Meta_L, Gdk.KEY_Meta_R, Gdk.KEY_Hyper_L, Gdk.KEY_Hyper_R,
                     Gdk.KEY_ISO_Level3_Shift, Gdk.KEY_Caps_Lock, Gdk.KEY_Num_Lock}

    def _edit_shortcut(self, name):
        current = gm.shortcut_get(name)
        body = "Press the keys to use — with Super, Ctrl or Alt, or a function key. Esc cancels."
        if current:
            ok, kv, mods = Gtk.accelerator_parse(current)
            body += f"\n\nNow: {Gtk.accelerator_get_label(kv, mods) if ok else current}"
        dlg = Adw.AlertDialog(heading=f"Shortcut for '{name}'", body=body)
        dlg.add_response("cancel", "Cancel")
        if current:
            dlg.add_response("clear", "Remove Shortcut")
            dlg.set_response_appearance("clear", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "clear" and self._clear_shortcut(name))

        def on_key(_ctrl, keyval, keycode, state):
            mods = state & Gtk.accelerator_get_default_mod_mask()
            if keyval == Gdk.KEY_Escape and not mods:
                dlg.close()
                return True
            if keyval in self.MODIFIER_KEYS:
                return False
            # the key's unshifted meaning, so Shift+1 is '<Shift>1', not 'exclam'
            ok, keys, keyvals = Gdk.Display.get_default().map_keycode(keycode)
            if ok and keys:
                keyval = min(zip(keys, keyvals), key=lambda kv: (kv[0].group, kv[0].level))[1]
            keyval = Gdk.keyval_to_lower(keyval)
            if not mods and not (Gdk.KEY_F1 <= keyval <= Gdk.KEY_F35):
                dlg.set_body(body + "\n\nA plain key would get in the way of typing — add Super, Ctrl or Alt.")
                return True
            accel = Gtk.accelerator_name(keyval, mods)
            try:
                gm.shortcut_set(name, accel)
            except gm.MonitorError as e:
                self._toast(str(e))
            else:
                self._toast(f"{Gtk.accelerator_get_label(keyval, mods)} applies '{name}'.")
            dlg.close()
            self._refresh()
            return True

        ctrl = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        ctrl.connect("key-pressed", on_key)
        dlg.add_controller(ctrl)
        dlg.present(self)

    def _clear_shortcut(self, name):
        gm.shortcut_clear(name)
        self._toast(f"Removed the shortcut of '{name}'.")
        self._refresh()

    def _delete_profile(self, name):
        dlg = Adw.AlertDialog(heading=f"Delete '{name}'?",
                              body="The profile file is removed. Your screens are not changed.")
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("delete", "Delete")
        dlg.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")
        dlg.connect("response", self._on_delete_response, name)
        dlg.present(self)

    def _on_delete_response(self, _dlg, response, name):
        if response != "delete":
            return
        try:
            gm.delete_profile(name)
        except gm.MonitorError as e:
            self._toast(str(e))
        else:
            gm.shortcut_clear(name)
            self._toast(f"Deleted '{name}'.")
        self._refresh()


# ── application ──────────────────────────────────────────────────────────────

class MonitorApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window()
        if not win:
            win = MonitorWindow(self)
        win.present()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    raise SystemExit(MonitorApp().run(None))
